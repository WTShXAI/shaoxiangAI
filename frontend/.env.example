# 哨响AI 前端环境变量
# 复制为 .env 并修改实际值

# Bridge API 地址 (预测/赛程/投注服务)。
# 默认留空 = 同源部署 (前端与 bridge_service:9000 同 origin, 规避 CORS)。
# 仅 Docker/远程跨机部署时填入: VITE_BRIDGE_URL=http://<host>:9000
VITE_BRIDGE_URL=

# 生产鉴权密钥 (可选): 配置后 axios 自动注入 X-API-Key 请求头。
# 开发环境无需设置。对应 bridge_service 侧必须同值放行, 否则 401。
VITE_API_KEY=

# ── 以下为历史遗留说明 (2026-07-17 架构审计后已停用) ──
# 主 API 地址 (/api/v1 前缀由 baseURL="/api/v1" 自动拼接)
# VITE_API_URL=http://localhost:9000

# 如需分离 bridge_service 与主 API, 分别设置:
# VITE_BRIDGE_URL=http://bridge:9000
# VITE_API_URL=http://api:8000
