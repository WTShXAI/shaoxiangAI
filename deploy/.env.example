# =============================================================================
# 哨响AI - 部署环境变量模板 (deploy/ 专用)
# =============================================================================
# 复制为 deploy/.env 并填入真实值:  cp deploy/.env.example deploy/.env
# .env 已在 .gitignore 中, 不会被提交. 真实密钥切勿入库 (CI 有 secret-scan 门禁).
# =============================================================================

# ── 运行模式 ──────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── 服务器配置 ───────────────────────────
API_HOST=0.0.0.0
API_PORT=9000

# ── 安全 ─────────────────────────────────
# 生产必须显式设置 (至少 32 字符随机串); 留空则服务应拒绝启动敏感接口
SECRET_KEY=__CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS__
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__CHANGE_ME__
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS (前端 nginx 同域, 此处放行 localhost 与容器内后端) ──
CORS_ORIGINS=["http://localhost:9000","http://localhost:8080","http://127.0.0.1:9000"]

# ── 数据库 ───────────────────────────────
DATABASE_URL="sqlite:///./data/football_data.db"

# ── 采集器 (乐鱼 GQ) ──────────────────────
# 乐鱼登录 URL 中 token= 后的十六进制串取前 18 位作为 CUID (REQUEST_ID).
# 留空则采集器无法拉取实时赔率 (不影响预测能力, 仅无新数据写入).
GQ_REQUEST_ID=
# 采集间隔(秒): 默认 60; 比赛日可调小 (如 30)
COLLECTOR_INTERVAL=60

# ── 第三方 API 密钥 (可选) ───────────────
FOOTBALL_DATA_API_KEY=
THE_ODDS_API_KEY=
WIDGET_ACCESS_KEY=
OCR_AK=
OCR_SK=

# ── GPU ─────────────────────────────────
# RTX 5070 Ti sm_120 不兼容, 留空强制 CPU 推理
CUDA_VISIBLE_DEVICES=

# ── 日志/健康检查调优 (守护脚本读取) ─────
# 子进程单日志文件上限(MB) / 备份数 (防历史 1.2GB 膨胀)
LOG_MAX_MB=20
LOG_BACKUPS=5
# /health 超时(秒), 超时视为后端冻结
HEALTH_TIMEOUT=8
# 巡检周期(秒) / 连续 health 失败次数判冻结
CHECK_INTERVAL=15
FREEZE_RETRIES=2
# 采集器 GQ.db 超过 N 分钟未更新判假死
COLLECTOR_MAX_MIN=10
